# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/shopnest

# Secret used to sign JWTs - use a long random string
JWT_SECRET=change_me_to_a_long_random_string

# Port the API listens on
PORT=5000

# Cloudinary credentials - only needed for admin image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to "true" to enable the destructive GET /api/seed endpoint.
# Deny-by-default: without this, seeding returns 403.
# NEVER set this on a deployed environment - seeding wipes all users/products.
ALLOW_SEED=true

# Comma-separated list of browser origins allowed to call this API.
# Unset = open CORS (fine locally). Set this on any deployed environment, e.g.
# CLIENT_URL=https://shopnest-five-umber.vercel.app
CLIENT_URL=
